#!/usr/bin/env node

/**
 * Script to safely add an addon to the addons array in .storybook/main.ts
 *
 * Usage:
 *   node ./4.6.5.patch <addon-name>
 *
 * Examples:
 *   node ./4.6.5.patch @storybook/addon-interactions
 *   node ./4.6.5.patch ./my-local-addon.ts
 *
 * Behavior:
 *   - Inserts the addon before './services-preset.ts' (the last entry)
 *   - Skips if the addon already exists
 *   - Preserves existing formatting and comments
 */

import { readFileSync, writeFileSync, existsSync } from 'node:fs';
import { resolve, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = dirname(fileURLToPath(import.meta.url));

// Default main.ts path (relative to script location or cwd)
const DEFAULT_MAIN_TS = resolve(__dirname, 'code/.storybook/main.ts');

function parseArgs(): { addon: string; mainTs: string } {
  const args = process.argv.slice(2);

  if (args.length === 0) {
    console.error('Usage: node ./4.6.5.patch <addon-name> [path-to-main.ts]');
    console.error('Example: node ./4.6.5.patch @storybook/addon-interactions');
    process.exit(1);
  }

  return {
    addon: args[0],
    mainTs: args[1] ?? DEFAULT_MAIN_TS,
  };
}

function addAddonToFile(content: string, addon: string): { updated: string; changed: boolean } {
  // Match the addons array block
  const addonsArrayRegex = /(addons\s*:\s*\[)([\s\S]*?)(\s*\],)/;
  const match = content.match(addonsArrayRegex);

  if (!match) {
    console.error('Error: Could not find addons array in main.ts');
    process.exit(1);
  }

  const [, prefix, existingAddons, suffix] = match;

  // Check if addon already exists (handles both quoted and unquoted forms)
  const normalizedAddon = addon.replace(/^['"]|['"]$/g, '');
  const addonExists = existingAddons.includes(normalizedAddon)
    || existingAddons.includes(`'${normalizedAddon}'`)
    || existingAddons.includes(`"${normalizedAddon}"`);

  if (addonExists) {
    console.log(`Addon "${normalizedAddon}" already exists in addons array. Skipping.`);
    return { updated: content, changed: false };
  }

  // Find the position of './services-preset.ts' to insert before it
  const servicesPresetIndex = existingAddons.lastIndexOf("'./services-preset.ts'");
  const altServicesPresetIndex = existingAddons.lastIndexOf('"./services-preset.ts"');
  const insertBeforeIndex = Math.max(servicesPresetIndex, altServicesPresetIndex);

  let newAddonsContent: string;

  if (insertBeforeIndex !== -1) {
    // Insert before './services-preset.ts'
    const beforeInsert = existingAddons.slice(0, insertBeforeIndex);
    const afterInsert = existingAddons.slice(insertBeforeIndex);

    // Determine indentation from existing entries
    const indentMatch = existingAddons.match(/^\s+/m);
    const indent = indentMatch ? indentMatch[0] : '    ';

    newAddonsContent = `${beforeInsert}${indent}'${normalizedAddon}',\n${afterInsert}`;
  } else {
    // No services-preset found, append to end
    const indentMatch = existingAddons.match(/^\s+/m);
    const indent = indentMatch ? indentMatch[0] : '    ';

    // Remove trailing comma from last entry if present
    const trimmed = existingAddons.replace(/,\s*$/, '');
    newAddonsContent = `${trimmed},\n${indent}'${normalizedAddon}',\n`;
  }

  const updated = content.replace(addonsArrayRegex, `${prefix}${newAddonsContent}${suffix}`);
  return { updated, changed: true };
}

function main(): void {
  const { addon, mainTs } = parseArgs();

  if (!existsSync(mainTs)) {
    console.error(`Error: File not found: ${mainTs}`);
    process.exit(1);
  }

  console.log(`Reading: ${mainTs}`);
  const content = readFileSync(mainTs, 'utf-8');

  const { updated, changed } = addAddonToFile(content, addon);

  if (!changed) {
    process.exit(0);
  }

  writeFileSync(mainTs, updated, 'utf-8');
  console.log(`Successfully added "${addon}" to addons array`);
}

main();
