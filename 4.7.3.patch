 // @ts-ignore - Needed for Angular sandbox running without --no-link option. Do NOT convert to @ts-expect-error!
 import { nodePathsToArray } from './paths.ts';
 
+export const BROWSER_TARGETS_OVERRIDE_ENV = 'BROWSER_TARGETS_OVERRIDE';
+
+const buildTargetPattern = /^(esnext|es\d{4}|[a-z]+(?:\d+(?:\.\d+)*)?)$/i;
+
+type BuildTarget = NonNullable<BuildOptions['target']>;
+type BuildTargetOverride = Extract<BuildTarget, string[]>;
+
+const isBuildTarget = (target: string): target is BuildTargetOverride[number] =>
+  buildTargetPattern.test(target);
+
+export const parseBrowserTargetsOverride = (
+  input: string | undefined
+): BuildTargetOverride | undefined => {
+  if (!input) {
+    return undefined;
+  }
+
+  const targets = parseList(input);
+
+  if (targets.length === 0 || !targets.every(isBuildTarget)) {
+    return undefined;
+  }
+
+  return targets;
+};
+
+export const getBrowserTargetsOverride = (
+  env: Record<string, string | undefined> = process.env
+): BuildTargetOverride | undefined => parseBrowserTargetsOverride(env[BROWSER_TARGETS_OVERRIDE_ENV]);
+
 // Load environment variables starts with STORYBOOK_ to the client side.
 
