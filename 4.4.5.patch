+<script setup lang="ts">
+defineProps<{
+  variant?: 'primary' | 'secondary' | 'ghost';
+  size?: 'sm' | 'md' | 'lg';
+  disabled?: boolean;
+}>();
+
+defineEmits<{
+  click: [event: MouseEvent];
+}>();
+</script>
